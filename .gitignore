__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.venv/

# Secrets — never commit
.env
.env.*
!.env.example

# Personal IDE config
*.code-workspace
.vscode/
.idea/
.codex/

# Claude/Codex personal state stays ignored, but the shipped skills are
# tracked so opening this folder in Claude Code / Codex auto-loads them.
.claude/*
!.claude/skills/
.agents/*
!.agents/skills/

# Local Sancho Fetch workspace — entirely personal/generated, never committed.
#
# The whole workspace is regenerated by `sancho setup` from the canonical
# templates in src/sancho/templates/ (AI_INSTRUCTIONS.md, DATASET_CATALOG.md,
# .env.example, the runtime, the sample module). Nothing here is the source of
# truth, so an end user who clones the repo just to fetch data should see ZERO
# git changes for anything they do — their fetches, custom overrides, MCP config
# (which bakes in machine-specific absolute paths), playbooks, logs, and exports
# are all theirs alone. A contributor who genuinely wants to share a custom
# override or playbook can `git add -f` it deliberately, or contribute it as a
# template under src/sancho/templates/modules/.
/sancho-workspace/
/sancho-export.zip

# Project bundles dropped into other working folders
**/sancho-downloads/

# Build artifacts
/dist/
/build/
*.egg-info/

# Repomix local packaging
/repomix-output.*

# Internal working documents -- never ship
/project-docs/AUDIT_*
/gameplan.md

# macOS Finder droppings
.DS_Store

# Internal planning/audit material -- never ship in the repo
/temp_update_doc.md
/.audit/
/docs/audits/
