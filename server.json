{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.panth-net/sancho-fetch",
  "title": "Sancho Fetch",
  "description": "Local-first public-data MCP server that writes inspectable records and working files.",
  "websiteUrl": "https://github.com/panth-net/sancho-fetch",
  "repository": {
    "url": "https://github.com/panth-net/sancho-fetch",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sancho-fetch",
      "version": "0.3.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--workspace",
          "valueHint": "workspace",
          "description": "Folder containing the persistent sancho-workspace data directory.",
          "format": "filepath",
          "isRequired": true
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ]
    }
  ]
}
