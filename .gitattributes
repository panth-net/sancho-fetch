# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files MUST be checked out with CRLF -- cmd.exe mis-parses
# multi-line blocks (e.g. `if (...)`) in LF-only .bat files, which breaks the
# double-click installer on some Windows versions.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts and the macOS double-click launcher must stay LF.
*.sh text eol=lf
*.command text eol=lf

# The committed MCPB must rebuild byte-for-byte on Windows, macOS, and Linux.
integrations/claude-desktop/.mcpbignore text eol=lf
integrations/claude-desktop/manifest.json text eol=lf
integrations/claude-desktop/pyproject.toml text eol=lf
integrations/claude-desktop/src/server.py text eol=lf
